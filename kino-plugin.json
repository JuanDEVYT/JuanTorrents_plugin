{
  "id": "mytorrents",
  "name": "Mis Torrents",
  "version": "0.2.0",
  "apiVersion": 8,
  "entry": "plugin.js",
  "description": "Pega el magnet o la URL .torrent de tus propios torrents (los de tu servidor) y reprodúcelos en Kino vía la API pública de Webtor.io.",
  "author": "JuanDEVYT",
  "homepage": "https://github.com/JuanDEVYT/kino-mytorrents",
  "hosts": ["api.webtor.io", "*.webtor.io"],
  "capabilities": ["home", "resolve", "episodes"],
  "color": "#2ECC71",
  "icon": "icon.png",
  "section": {
    "label": "Mis Torrents"
  },
  "debug": false,
  "telemetry": false,
  "settings": [
    {
      "key": "about",
      "label": "Mis Torrents",
      "type": "section",
      "hint": "Pega hasta 10 magnets o URLs .torrent tuyas, una por campo. Cada una aparece como un título en Inicio; si trae varios archivos de video, se ven como episodios."
    },
    { "key": "torrent1", "label": "Torrent 1", "type": "url", "hint": "magnet:?xt=urn:btih:... o https://.../archivo.torrent" },
    { "key": "torrent2", "label": "Torrent 2", "type": "url" },
    { "key": "torrent3", "label": "Torrent 3", "type": "url" },
    { "key": "torrent4", "label": "Torrent 4", "type": "url" },
    { "key": "torrent5", "label": "Torrent 5", "type": "url" },
    { "key": "torrent6", "label": "Torrent 6", "type": "url" },
    { "key": "torrent7", "label": "Torrent 7", "type": "url" },
    { "key": "torrent8", "label": "Torrent 8", "type": "url" },
    { "key": "torrent9", "label": "Torrent 9", "type": "url" },
    { "key": "torrent10", "label": "Torrent 10", "type": "url" },
    {
      "key": "apiKey",
      "label": "API key de Webtor (opcional)",
      "type": "password",
      "hint": "Opcional. Sin ella usas el límite gratuito compartido de Webtor."
    },
    {
      "key": "linked",
      "label": "Estado",
      "type": "status"
    },
    {
      "key": "refresh",
      "label": "Volver a cargar los torrents",
      "type": "action"
    }
  ]
}
