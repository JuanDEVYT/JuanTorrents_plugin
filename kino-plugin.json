{
  "id": "mytorrents",
  "name": "Mis Torrents",
  "version": "0.5.1",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Pega el magnet de tus propios torrents y reprodúcelos en Kino usando la web de Webtor.",
  "author": "JuanDEVYT",
  "homepage": "https://github.com/JuanDEVYT/JuanTorrents_plugin",
  "hosts": [
    "webtor.io",
    "*.webtor.io"
  ],
  "capabilities": [
    "home",
    "resolve"
  ],
  "color": "#2ECC71",
  "icon": "icon.png",
  "section": {
    "label": "Mis Torrents"
  },
  "debug": false,
  "telemetry": false,
  "settings": [
    {
      "key": "about",
      "label": "Mis Torrents",
      "type": "section",
      "hint": "Pega el magnet de tus torrents; salen en Inicio."
    },
    {
      "key": "torrents",
      "label": "Tus torrents",
      "type": "list",
      "max": 20,
      "fields": [
        {
          "key": "nombre",
          "label": "Nombre",
          "type": "text",
          "hint": "Opcional"
        },
        {
          "key": "url",
          "label": "Magnet o hash",
          "type": "text",
          "required": true,
          "hint": "magnet:?xt=urn:btih:HASH o solo el HASH (máx. 500 caracteres)"
        }
      ]
    }
  ],
  "browser": true,
  "streamHosts": "any"
}
