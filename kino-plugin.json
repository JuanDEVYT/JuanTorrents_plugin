{
  "id": "mytorrents",
  "name": "Mis Torrents",
  "version": "0.4.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Pega el magnet o URL .torrent de tus propios torrents y reprodúcelos en Kino con la API de Webtor (vía RapidAPI).",
  "author": "JuanDEVYT",
  "homepage": "https://github.com/JuanDEVYT/JuanTorrents_plugin",
  "hosts": [
    "webtor.p.rapidapi.com",
    "*.webtor.io"
  ],
  "capabilities": [
    "home",
    "resolve",
    "episodes"
  ],
  "color": "#2ECC71",
  "icon": "icon.png",
  "section": {
    "label": "Mis Torrents"
  },
  "debug": false,
  "telemetry": false,
  "settings": [
    {
      "key": "about",
      "label": "Mis Torrents",
      "type": "section",
      "hint": "Pega el magnet o URL .torrent de tus torrents; salen en Inicio."
    },
    {
      "key": "torrents",
      "label": "Tus torrents",
      "type": "list",
      "max": 20,
      "fields": [
        {
          "key": "nombre",
          "label": "Nombre",
          "type": "text",
          "hint": "Opcional"
        },
        {
          "key": "url",
          "label": "Magnet o URL .torrent",
          "type": "text",
          "required": true,
          "hint": "magnet:?xt=urn:btih:HASH (máx. 500 caracteres) o URL .torrent"
        }
      ]
    },
    {
      "key": "apiKey",
      "label": "API key de RapidAPI (Webtor)",
      "type": "password",
      "hint": "Gratis en rapidapi.com: suscríbete a Webtor y copia tu key",
      "required": true
    },
    {
      "key": "linked",
      "label": "Estado",
      "type": "status"
    },
    {
      "key": "refresh",
      "label": "Volver a cargar los torrents",
      "type": "action"
    }
  ]
}
